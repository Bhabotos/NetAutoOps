# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection (Phase 2)
DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@localhost:5432/<db_name>

# Logging
LOG_LEVEL=INFO

# Phase 3: Netmiko device monitoring
# Shared lab SSH credential used to read device health over SSH. The
# inventory only stores usernames (per-device secret storage / vault
# integration is planned for a later phase) -- the password below is used
# for every device the monitoring service connects to.
DEVICE_SSH_PASSWORD=
# Only needed if your lab devices require entering enable/privileged mode
# before running the read-only show/display commands.
DEVICE_ENABLE_SECRET=

# Optional monitoring tuning (defaults shown)
NETMIKO_TIMEOUT=10
TCP_CHECK_TIMEOUT=3
