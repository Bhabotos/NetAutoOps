# Copy this file to .env and fill in real values. Never commit .env.

# PostgreSQL connection (Phase 2)
DATABASE_URL=postgresql+psycopg2://<db_user>:<db_password>@localhost:5432/<db_name>

# Logging
LOG_LEVEL=INFO

# Phase 3: Netmiko device monitoring
# Shared lab SSH credential used to read device health over SSH. The
# inventory only stores usernames (per-device secret storage / vault
# integration is planned for a later phase) -- the password below is used
# for every device the monitoring service connects to.
DEVICE_SSH_PASSWORD=
# Only needed if your lab devices require entering enable/privileged mode
# before running the read-only show/display commands.
DEVICE_ENABLE_SECRET=

# Optional monitoring tuning (defaults shown)
NETMIKO_TIMEOUT=10
TCP_CHECK_TIMEOUT=3

# Phase 4: configuration backups. Reuses DEVICE_SSH_PASSWORD/DEVICE_ENABLE_SECRET
# above. Backups can take longer to print than a "show version", so they get
# their own read timeout (seconds).
BACKUP_COMMAND_TIMEOUT=60

# Phase 5: n8n webhook integration. Leave empty to disable event delivery
# entirely (it becomes a safe no-op, logged but never sent) -- useful while
# developing without a local n8n instance running.
# Treat this URL like a credential: n8n webhook paths embed an effectively-
# secret, unguessable id.
N8N_WEBHOOK_URL=
N8N_WEBHOOK_TIMEOUT=5
N8N_WEBHOOK_MAX_RETRIES=3
N8N_WEBHOOK_RETRY_BACKOFF_SECONDS=1

# Phase 6: only needed when running via `docker compose up` -- these
# initialize the containerized PostgreSQL service (docker-compose.yml's `db`
# service) and are used to build DATABASE_URL for the `app` container
# automatically (pointing at "db", not "localhost"). Not used when running
# NetAutoOps directly on the host with `uvicorn` -- that path still uses
# DATABASE_URL above as-is. Pick your own POSTGRES_PASSWORD; there is no
# default.
POSTGRES_USER=netautoops_user
POSTGRES_PASSWORD=
POSTGRES_DB=netautoops_db

# Phase 7: interface discovery. Reuses DEVICE_SSH_PASSWORD/DEVICE_ENABLE_SECRET
# above -- no new credentials needed.
INTERFACES_COMMAND_TIMEOUT=30

# Phase 8: scheduled automated checks. Set to false to disable the
# background scheduler entirely (no credentials involved -- reuses the same
# DEVICE_SSH_PASSWORD as manual checks).
SCHEDULER_ENABLED=true
HEALTH_CHECK_INTERVAL_MINUTES=15
BACKUP_INTERVAL_MINUTES=1440
INTERFACE_CHECK_INTERVAL_MINUTES=15
